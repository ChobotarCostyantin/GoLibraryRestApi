# Приклади використання REST API для бібліотек

# 1. Створити нову бібліотеку (CREATE)
# curl -X POST http://localhost:8080/libraries \
#   -H "Content-Type: application/json" \
#   -d '{
#     "name": "Центральна міська бібліотека",
#     "address": "вул. Шевченка, 10",
#     "books": []
#   }'
POST http://localhost:8080/libraries
Content-Type: application/json

{
    "name": "Центральна міська бібліотека",
    "address": "вул. Шевченка, 10",
    "books": []
}

# 2. Отримати всі бібліотеки (READ)
# curl http://localhost:8080/libraries

GET http://localhost:8080/libraries

# 3. Отримати конкретну бібліотеку за ID (READ)
curl http://localhost:8080/libraries/1

# 4. Оновити бібліотеку (UPDATE)
curl -X PUT http://localhost:8080/libraries/1 \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Центральна міська бібліотека ім. Франка",
    "address": "вул. Шевченка, 10",
    "books": []
  }'

# 5. Додати книгу до бібліотеки (CREATE BOOK)
curl -X POST http://localhost:8080/libraries/1/books \
  -H "Content-Type: application/json" \
  -d '{
    "title": "Тіні забутих предків",
    "pages": 192,
    "author": {
      "name": "Михайло Коцюбинський",
      "birth_year": 1864
    }
  }'

# 6. Додати ще одну книгу
curl -X POST http://localhost:8080/libraries/1/books \
  -H "Content-Type: application/json" \
  -d '{
    "title": "Захар Беркут",
    "pages": 256,
    "author": {
      "name": "Іван Франко",
      "birth_year": 1856
    }
  }'

# 7. Отримати всі книги бібліотеки (READ)
curl http://localhost:8080/libraries/1/books

# 8. Видалити бібліотеку (DELETE)
curl -X DELETE http://localhost:8080/libraries/1

# 9. Створити бібліотеку з книгами одразу
curl -X POST http://localhost:8080/libraries \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Обласна наукова бібліотека",
    "address": "пл. Театральна, 5",
    "books": [
      {
        "title": "Кобзар",
        "pages": 448,
        "author": {
          "name": "Тарас Шевченко",
          "birth_year": 1814
        }
      },
      {
        "title": "Лісова пісня",
        "pages": 128,
        "author": {
          "name": "Леся Українка",
          "birth_year": 1871
        }
      }
    ]
  }'

# 10. Отримати бібліотеку з книгами у форматованому вигляді
curl http://localhost:8080/libraries/2 | json_pp